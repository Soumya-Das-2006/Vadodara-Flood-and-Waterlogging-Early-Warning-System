# Copy to .env (never commit .env). All optional: without keys, alerts use fixed templates and Telegram is skipped.
API_KEY=change-me
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# LLM_PROVIDER=groq            # default; set to anthropic to use ANTHROPIC_API_KEY / CLAUDE_MODEL instead
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
